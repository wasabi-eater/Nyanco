-- Nyanco 0.38 prefix
data box 'a = Box ['a]
instance streem (box 'a) where
    item : 'a
    each (Box xs) f = each xs f

main =
    print (vector (take (map (1 ..= 10) {* 2}) 3));
    print (vtakeWhile [1,2,3,1] {< 3});
    print (vskipWhile [1,2,3,1] {< 3});
    print (vflatMap (Box [1,2]) {-> n; Box [n,n + 10]});
    print (vector (flatten (Box [Box [1,2],Box [3]])));
    print (vector (@mapped map [1,2,3] {
        when ($ == 2) {cancel@mapped};
        * 10
    }));
    print (vtake (fromYield {yield 7; yield 8; yield 9}) 2)
