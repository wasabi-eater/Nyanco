-- Nyanco 0.38 prefix

effect yield 'a: 'a ->

effect ask 'a:  -> 'a

first : {int ->  / {yield int}}

first =
  {( + (10)), yield}

second : { -> int / {yield int}}

second =
  {2, yield, 3}

third : { ->  / {ask 'a, yield 'a}}

third =
  {ask, yield}

run : { -> int / { | 'e}} -> int / { | 'e}

run =
  call

main :  ->  / {io}

main =
  {second, run}, {yield: ({-> value k, value, print, k, resume})}, handle, print
