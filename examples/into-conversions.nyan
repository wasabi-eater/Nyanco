-- Nyanco 0.38 prefix
data distance = Distance float
instance into int distance where
  from n = Distance (float n)
instance into distance int where
  from (Distance n) = int n

makeDistance : int -> distance / {exn}
makeDistance = fromInt

asInt : distance -> int / {exn}
asInt = from

floats : [int] -> [float] / {exn}
floats xs = vmap xs {from}

main =
  print (makeDistance 42);
  print (asInt (makeDistance 42));
  print (int (makeDistance 7));
  print (floats [1,2,3]);
  print (int 'あ')
