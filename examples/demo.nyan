-- Nyanco 0.38 prefix

square : int -> int

square x =
  ((x) * (x))

factorial 0 =
  1

factorial n =
  ((n) * (((((n) - (1))), factorial)))

makeAdder n =
  {((_) + (n))}

sum =
  0, {((_1) + (_))}, fold

main =
  "Squares:", print, [1, 2, 3, 4, 5], {square}, vmap, print, "Factorial 6:", print, 6, factorial, print, "Even numbers in 1..10:", print, 1, 10, range, {((((_) % (2))) == (0))}, vfilter, print, "Sum 1..100:", print, 1, 100, range, sum, print, "Closure (10 + 7):", print, 10, 7, makeAdder, call, print
