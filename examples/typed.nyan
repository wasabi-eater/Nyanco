-- Nyanco 0.38 prefix

square : int -> int

square x =
  ((x) * (x))

identity : 'a -> 'a

identity x =
  x

factorial 0 =
  1

factorial n =
  ((n) * (((((n) - (1))), factorial)))

makeAdder n =
  {((_) + (n))}

main =
  5, square, print, "hello", identity, print, True, identity, print, [1, 2, 3], 10, makeAdder, vmap, print, 0, [1, 2, 3], {( + )}, each, print, 6, factorial, print
