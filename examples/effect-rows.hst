-- HaskStack 0.38 prefix

effect yield 'a: 'a -> 

effect ask 'a:  -> 'a

first : {num ->  / {yield num}}

first =
  {( + (10)), yield}

second : { -> num / {yield num}}

second =
  {2, yield, 3}

third : { ->  / {ask 'a, yield 'a}}

third =
  {ask, yield}

run : { -> num / { | 'e}} -> num / { | 'e}

run =
  call

main :  ->  / {io}

main =
  {second, run}, {yield: ({-> value k, value, print, k, resume})}, handle, print
