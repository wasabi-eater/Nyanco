-- Nyanco 0.38 prefix

sum : [int] -> int

sum [] =
  0

sum (xs :: x) =
  ((x) + ((xs, sum)))

reverseByPattern [] =
  []

reverseByPattern (xs :: x) =
  (([x]) ++ ((xs, reverseByPattern)))

describe [] =
  "empty"

describe [_] =
  "one item"

describe (_ :: _) =
  "multiple items"

main =
  (((((([]) :: (1))) :: (2))) :: (3)), -> items, items, sum, print, items, reverseByPattern, print, items, describe, print
