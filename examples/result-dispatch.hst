-- HaskStack 0.38 prefix
-- Instances are selected from inferred types, including result types.
class zero 'a where
  zero : -> 'a

instance zero num where
  zero = 0

instance zero string where
  zero = ""

data box 'a = Box 'a
instance zero 'a => zero (box 'a) where
  zero = Box zero

origin : -> num
origin = zero
emptyText : -> string
emptyText = zero
boxed : -> box num
boxed = zero
getZero = zero
produce = yield getZero

main =
  print origin;
  print (emptyText == "");
  print boxed;
  print (getZero; + 1);
  print (call {getZero}; + 2);
  print (toVector (map [1,2] {drop; getZero}); head; + 3);
  print (toVector (fromYield {produce}); head; + 4)
