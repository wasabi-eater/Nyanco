-- HaskStack 0.38 prefix
-- Prefix evaluation, comma clauses, and associated types (0.38).
abs = when ($ < 0) {0 -}
sum xs = 0; each xs {+}

data box 'a = Box 'a
class unpack 'c where
  type item
  unpack : 'c -> item
instance unpack (box 'a) where
  item : 'a
  unpack (Box x) = x

effect yield 'a: 'a ->
main =
  print (abs -5);
  print (sum [1, 2, 3]);
  print (unpack (Box "hello"));
  handle {yield 42} {yield: {-> value k; print value; resume k}};
  3, 4; _, _; print; print; print
