-- Nyanco 0.38 prefix
effect ask : -> int

main =
    @outer each (1 ..= 3) {
        -> x;
        each (1 ..= 3) {
            -> y;
            when (x + y > 4) {break@outer};
            print #(x,y)
        }
    };
    @outer handle {
        handle {ask@outer; print; mask ask {ask}; print; ask; print}
          {ask: {-> k; resume 2 k}}
    } {ask: {-> k; resume 1 k}};
    print (toVector (@outer fromYield {
        yield 1;
        each (fromYield {yield@outer 2; yield 3}) {yield}
    }))
