-- Nyanco 0.38 prefix
effect ask : -> int
loop = while {True} _
main =
  1; loop @a {* 2; print $; when ($ > 8) {break@a}}; drop;
  handle @outer {
    handle @inner {print ask@inner; print ask@outer}
      {ask: {-> k; resume 20 k}}
  } {ask: {-> k; resume 10 k}};
  print (toVector (fromYield @producer {yield@producer 1; yield@producer 2}))
