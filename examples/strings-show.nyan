-- Nyanco 0.38 prefix
data person = Person string int
instance show person where
  show (Person name age) = name ++ ":" ++ (show age)
main =
  print ("hello" ++ ", world");
  print (vector (split "a,,b," ","));
  print (join (split "a,b,c" ",") " / ");
  print (toNum " -1.25e2 ");
  print (toNum "oops");
  print (handle {parseFloat "bad"} {exn: {-> message k; 0}});
  print (show (Person "Ada" 37))
